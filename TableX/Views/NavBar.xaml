<UserControl x:Class="TableX.Views.NavBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Inter, Segoe UI"
             UseLayoutRounding="True">

    <!-- Su DataContext es el ShellVM. El aspecto está en Styles/NavBarStyles.xaml -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Styles/NavBarStyles.xaml"/>
    </UserControl.Resources>

    <Border Background="{StaticResource TxCard}"
            BorderBrush="{StaticResource TxLine}"
            BorderThickness="0,0,0,1"
            Padding="20,10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Image Grid.Column="0"
                   Source="/Images/TablexIMG/tablex-logo-horizontal.png"
                   Height="44"
                   Margin="0,0,20,0"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!-- Pestañas -->
            <ListBox Grid.Column="1"
                     Style="{StaticResource TxNavTabs}"
                     ItemsSource="{Binding NavItems}"
                     SelectedItem="{Binding SelectedItem}"
                     VerticalAlignment="Center"/>

            <!-- Usuario y cerrar sesión -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0">
                <Border Width="36" Height="36"
                        CornerRadius="18"
                        Background="{StaticResource TxInk}"
                        Margin="0,0,10,0">
                    <TextBlock Text="{Binding UserInitials}"
                               Foreground="White"
                               FontSize="12"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding UserName}"
                               Foreground="{StaticResource TxInk}"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding UserRole}"
                               Foreground="{StaticResource TxMuted}"
                               FontSize="12"/>
                </StackPanel>
                <Button Style="{StaticResource TxLogoutButton}"
                        Command="{Binding LogoutCommand}"
                        ToolTip="Cerrar sesión"
                        AutomationProperties.Name="Cerrar sesión"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
