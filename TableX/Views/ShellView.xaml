<UserControl x:Class="TableX.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TableX.Views">
    <!-- La NavBar se mantiene fija y solo cambia la página de debajo -->
    <DockPanel>
        <views:NavBar DockPanel.Dock="Top"/>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
    </DockPanel>
</UserControl>
