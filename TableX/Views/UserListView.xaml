<UserControl x:Class="TableX.Views.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:TableX.Utilities"
             Background="#E7E5E0"
             FontFamily="Inter, Segoe UI">

    <!-- Su DataContext es un UserListVM -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Colores de la app (TxInk, TxCard, TxLine...) -->
                <ResourceDictionary Source="/Styles/NavBarStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Cabecera de columna -->
            <Style x:Key="TxHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TxMuted}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="BorderBrush" Value="{StaticResource TxLine}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
            </Style>

            <!-- Celda: sin borde ni resaltado azul al seleccionar -->
            <Style x:Key="TxCell" TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{StaticResource TxInk}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Padding="16,0" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fila -->
            <Style x:Key="TxRow" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="MinHeight" Value="52"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource TxHover}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Botón Editar de la fila: solo el icono del lápiz (NavIcons.Pencil) -->
            <Style x:Key="TxEditButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TxText}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTip" Value="Editar"/>
                <Setter Property="AutomationProperties.Name" Value="Editar"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource TxFocusVisual}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Width="36" Height="36"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <Viewbox Width="18" Height="18">
                                    <Canvas Width="24" Height="24">
                                        <Path x:Name="Icon"
                                              Data="{Binding Source={x:Static util:NavIcons.Pencil}}"
                                              Stroke="{TemplateBinding Foreground}"
                                              Style="{StaticResource TxIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="White"/>
                                    <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TxOrange}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Usuarios"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TxInk}"
                   Margin="0,0,0,16"/>

        <!-- Tarjeta con la tabla -->
        <Border Grid.Row="1"
                Background="{StaticResource TxCard}"
                BorderBrush="{StaticResource TxLine}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">
            <DockPanel>

            <!-- Cargando / sin usuarios / error. Se oculta cuando StatusMessage es null -->
            <TextBlock DockPanel.Dock="Bottom"
                       Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TxMuted}"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Margin="0,16">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <DataGrid ItemsSource="{Binding Users}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource TxLine}"
                      Background="Transparent"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      FontSize="14"
                      ColumnHeaderStyle="{StaticResource TxHeader}"
                      CellStyle="{StaticResource TxCell}"
                      RowStyle="{StaticResource TxRow}">
                <DataGrid.Columns>

                    <!-- Usuario -->
                    <DataGridTextColumn Header="USUARIO"
                                        Binding="{Binding Username}"
                                        Width="*"/>

                    <!-- Rol: como etiqueta -->
                    <DataGridTemplateColumn Header="ROL" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="{StaticResource TxLine}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,3"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Role}"
                                               FontSize="12"
                                               Foreground="{StaticResource TxText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Acciones: los comandos están en el UserListVM, no en UserInfo,
                         por eso se busca el DataContext del UserControl -->
                    <DataGridTemplateColumn Header="ACCIONES" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Eliminar irá dentro de la pantalla de edición -->
                                <Button Style="{StaticResource TxEditButton}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DataContext.EditUserCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
