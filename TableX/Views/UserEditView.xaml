<UserControl x:Class="TableX.Views.UserEditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:util="clr-namespace:TableX.Utilities"
             FontFamily="Inter, Segoe UI"
             UseLayoutRounding="True">

    <!-- Su DataContext es un UserEditVM. Los estilos están en Styles/FormStyles.xaml -->
    <UserControl.Resources>
        <ResourceDictionary Source="/Styles/FormStyles.xaml"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Tarjeta centrada -->
        <Border MaxWidth="560"
                Margin="32"
                VerticalAlignment="Top"
                Background="{StaticResource TxCard}"
                BorderBrush="{StaticResource TxLine}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="28">
            <StackPanel>

                <!-- ========== Volver ========== -->
                <Button Style="{StaticResource TxBackButton}"
                        Content="Volver"
                        Command="{Binding BackCommand}"/>

                <Border Height="1" Background="{StaticResource TxLine}" Margin="0,16,0,24"/>

                <!-- ========== Cabecera: avatar + nombre ========== -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="72" Height="72"
                            CornerRadius="36"
                            Background="{StaticResource TxInk}"
                            Margin="0,0,20,0">
                        <Viewbox Width="34" Height="34">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Source={x:Static util:NavIcons.User}}"
                                      Stroke="White"
                                      Style="{StaticResource TxIconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding OriginalName}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TxInk}"/>
                        <TextBlock Text="{Binding Id, StringFormat='ID {0}'}"
                                   FontSize="13"
                                   Foreground="{StaticResource TxMuted}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- ========== Aviso de modo pruebas ========== -->
                <Border Background="#FFF1EA"
                        BorderBrush="#FFD3BF"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,24,0,0">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="{StaticResource TxText}">
                        <Run FontWeight="SemiBold" Text="Panel de pruebas:"/>
                        <Run Text="la API todavía no permite modificar usuarios, así que «Guardar cambios» no envía nada. «Eliminar usuario» sí borra el usuario en la API."/>
                    </TextBlock>
                </Border>

                <!-- ========== Campos ========== -->
                <TextBlock Style="{StaticResource TxFieldLabel}" Text="Nombre de usuario"/>
                <TextBox Style="{StaticResource TxTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Style="{StaticResource TxFieldLabel}" Text="Rol del usuario"/>
                <ComboBox Style="{StaticResource TxComboBox}"
                          Tag="{x:Static util:NavIcons.Shield}"
                          ItemsSource="{Binding Roles}"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding Role}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Resultado o error. Se oculta cuando StatusMessage es null -->
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{StaticResource TxOrange}"
                           Margin="0,16,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- ========== Botones ========== -->
                <Grid Margin="0,28,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource TxPrimaryButton}"
                            Tag="{x:Static util:NavIcons.Save}"
                            Content="Guardar cambios"
                            Command="{Binding SaveCommand}"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource TxOutlineButton}"
                            Tag="{x:Static util:NavIcons.Trash}"
                            Content="Eliminar usuario"
                            Command="{Binding DeleteCommand}"/>
                </Grid>

                <!-- Solo si estás editando tu propio usuario -->
                <TextBlock Text="No puedes eliminar tu propio usuario"
                           FontSize="12"
                           Foreground="{StaticResource TxMuted}"
                           HorizontalAlignment="Right"
                           Margin="0,8,0,0"
                           Visibility="{Binding IsSelf, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
