<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Aspecto de la NavBar. La estructura está en Views/NavBar.xaml -->

    <!-- ========== Colores ========== -->

    <SolidColorBrush x:Key="TxOrange" Color="#FF5A26"/>
    <SolidColorBrush x:Key="TxInk"    Color="#0A0A0A"/>
    <SolidColorBrush x:Key="TxText"   Color="#3F3F46"/>
    <SolidColorBrush x:Key="TxMuted"  Color="#8A8A8F"/>
    <SolidColorBrush x:Key="TxCard"   Color="#F3F2EE"/>
    <SolidColorBrush x:Key="TxLine"   Color="#E2E1DC"/>
    <SolidColorBrush x:Key="TxHover"  Color="#E9E8E3"/>

    <!-- ========== Comunes ========== -->

    <!-- Foco visible solo al navegar con teclado -->
    <Style x:Key="TxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle RadiusX="8" RadiusY="8"
                               Stroke="{StaticResource TxOrange}" StrokeThickness="2"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icono de línea -->
    <Style x:Key="TxIconPath" TargetType="Path">
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
    </Style>

    <!-- ========== Pestañas ========== -->

    <!-- Una pestaña: su DataContext es un NavItemVM -->
    <Style x:Key="TxNavTab" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TxText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TxFocusVisual}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon"
                                          Data="{Binding Icon}"
                                          Stroke="{TemplateBinding Foreground}"
                                          Style="{StaticResource TxIconPath}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="Label"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TxHover}"/>
                        </Trigger>
                        <!-- Pestaña activa: va al final para mandar también sobre el hover -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="White"/>
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TxOrange}"/>
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TxInk}"/>
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La lista de pestañas: si la ventana es estrecha, pasan a otra fila en vez de cortarse -->
    <Style x:Key="TxNavTabs" TargetType="ListBox">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource TxNavTab}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========== Cerrar sesión ========== -->

    <Style x:Key="TxLogoutButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TxText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource TxFocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Width="36" Height="36"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Icon"
                                      Data="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M8 7l-5 5 5 5 M3 12h12"
                                      Stroke="{TemplateBinding Foreground}"
                                      Style="{StaticResource TxIconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource TxHover}"/>
                            <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource TxOrange}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
