<Application x:Class="TableX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TableX"
             xmlns:vm="clr-namespace:TableX.ViewModels"
             xmlns:views="clr-namespace:TableX.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Cada ViewModel se pinta con su View cuando NavigationVM.CurrentView cambia -->
        <DataTemplate DataType="{x:Type vm:LoginVM}">
            <views:LoginView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ShellVM}">
            <views:ShellView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:HomeVM}">
            <views:HomeView/>
        </DataTemplate>

    </Application.Resources>
</Application>
